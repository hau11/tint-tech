{
  "name": "tint-intelligence-ai",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tint-intelligence",
      "database_id": "c3589794-a92f-47f2-a103-ad0459352be0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "tint-documents"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLUEPRINTS",
      "id": "380da4d2f09540fc8619fe7056d048b5"
    }
  ],
  "triggers": {
    "crons": ["30 11 * * *"]
  },
  "observability": { "enabled": true }
}