{
  "name": "tint-intelligence-ai",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tint-intelligence",
      "database_id": "c3589794-a92f-47f2-a103-ad0459352be0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "tint-documents"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLUEPRINTS",
      "id": "380da4d2f09540fc8619fe7056d048b5"
    }
  ],
  // One invocation can only cover ~30 sources before it runs out of
  // subrequests, so a single weekly trigger reached all 92 about once a month.
  // Four runs a day x 30 sources = 120, which clears the whole registry every
  // day. 11:30 UTC is the one that also sends the morning brief.
  "triggers": {
    "crons": ["30 11 * * *", "30 15 * * *", "30 19 * * *", "30 23 * * *"]
  },
  "observability": { "enabled": true }
}